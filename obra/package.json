{
  "name": "arken-obra",
  "productName": "ARKEN OBRA",
  "version": "1.0.0",
  "description": "ARKEN OBRA · Las apps de la familia ARKEN 360 (CONTROL, PRECIOS, ANALYTICA y BANK) en un solo programa de escritorio para Windows.",
  "private": true,
  "main": "electron/main.cjs",
  "author": "ARKEN 360",
  "scripts": {
    "armar": "node herramientas/armar.mjs",
    "escritorio": "npm run armar && electron .",
    "dist:windows": "npm run armar && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run armar && electron-builder --linux dir --publish never",
    "prueba:escritorio": "node pruebas/escritorio.mjs"
  },
  "dependencies": {
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "com.aboteroproyectos.arkenobra",
    "productName": "ARKEN OBRA",
    "executableName": "arken-obra",
    "copyright": "© ARKEN 360",
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "electron/**",
      "inicio/**",
      "apps/**",
      "package.json",
      "!node_modules/canvas/**",
      "!node_modules/path2d-polyfill/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types,cmaps,standard_fonts}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/xlsx/{bin,types}/**",
      "!**/*.{map,d.ts,md}"
    ],
    "asar": true,
    "npmRebuild": false,
    "icon": "recursos/icono.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ARKEN-OBRA-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARKEN OBRA",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office"
    },
    "publish": null
  }
}
